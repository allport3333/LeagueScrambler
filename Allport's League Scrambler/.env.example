# Copy to .env in the same folder as Startup.cs and fill in local values.
# Do not commit .env. The repository already ignores this file.

LEAGUESCRAMBLER_DB_CONNECTION=Server=localhost;Database=LeagueScrambler;User Id=YOUR_SQL_USERNAME;Password=YOUR_NEW_SQL_PASSWORD;
# Generate a random 32-byte key and encode it as Base64. Keep it stable across restarts.
# LEAGUESCRAMBLER_VERIFICATION_KEY=YOUR_BASE64_KEY
SMTP_MODE=smtp
# SMTP mode requires STARTTLS and credentials. Use the host and submission port supplied by the mailbox provider.
SMTP_SERVER=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
# Optional sender address if your mailbox provider authorized a different From address.
# SMTP_FROM=your-authorized-sender@example.com
# For isolated Development or Staging capture, use SMTP_MODE=pickup with an existing absolute directory.
# SMTP_PICKUP_DIRECTORY=C:/LocalMailCapture
# Optional: owner for leagues created through the legacy administration password.
# If omitted, a single Admin user in the database will be used.
# LEAGUESCRAMBLER_LEGACY_ADMIN_EMAIL=your-admin@example.com
# The public HTTPS address used in password recovery emails.
LEAGUESCRAMBLER_PUBLIC_BASE_URL=https://www.allportsleaguehub.com
# Local Development may explicitly use https://localhost:5001 instead.
# Localhost and other hosts are rejected outside Development.
